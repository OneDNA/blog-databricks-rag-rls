        <mxCell id="break" value="&lt;b style=&quot;color:#FF3621;font-size:20px;&quot;&gt;enforcement&lt;br&gt;stops here&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;a vector is a&lt;br&gt;list of floats&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF3621;strokeWidth=3;dashed=1;dashPattern=6 4;fixDash=1;align=center;verticalAlign=middle;fontSize=17;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="pipe">
