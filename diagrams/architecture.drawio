        <mxCell id="meta" value="&lt;b&gt;Metadata is content.&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;&quot;&gt;Whatever you index is readable by anyone who can query the index, &lt;i&gt;created_by_email&lt;/i&gt; and &lt;i&gt;web_url&lt;/i&gt; included. The ACL applies before any column is returned, not just the chunk text.&lt;/span&gt;" style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#F9F7F4;strokeColor=#D9D7CE;strokeWidth=1;align=left;verticalAlign=top;spacing=8;fontSize=16;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="pipe">
