        </mxCell>
        <mxCell id="drop" value="&lt;b style=&quot;color:#FF3621;&quot;&gt;Silently ignored&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;&quot;&gt;A filter naming a column the index does not have stops constraining. No error, no log line, and a plausible row count.&lt;/span&gt;" style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF3621;strokeWidth=1;align=left;verticalAlign=top;spacing=8;fontSize=16;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="q">
          <mxGeometry x="600" y="400" width="590" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="sp" value="&lt;b style=&quot;color:#FF3621;&quot;&gt;Non-interactive callers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;&quot;&gt;On a service-principal path the SP is the evaluated identity, so every human calling through it sees the union of what the SP was granted. Review what the SP is granted, not the space.&lt;/span&gt;" style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF3621;strokeWidth=1;align=left;verticalAlign=top;spacing=8;fontSize=16;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="q">
