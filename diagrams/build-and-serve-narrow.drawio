        <mxCell id="b3" value="built against" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#143D4A;strokeWidth=2;dashed=1;dashPattern=6 4;fixDash=1;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontSize=10;fontStyle=1;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="build" source="agent" target="idx">
