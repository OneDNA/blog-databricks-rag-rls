        <mxCell id="src" value="&lt;b style=&quot;font-size:17px;color:#1B3139;&quot;&gt;Source systems&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#618794;&quot;&gt;SharePoint, fileshares.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#618794;&quot;&gt;Owners publish there.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D9D7CE;strokeWidth=2;align=left;spacingLeft=48;verticalAlign=middle;spacing=8;fontSize=17;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=18;" vertex="1" parent="build">
          <mxGeometry x="20" y="66" width="460" height="93" as="geometry"/>
        </mxCell>
        <mxCell id="prep" value="&lt;b style=&quot;font-size:17px;color:#1B3139;&quot;&gt;Preprocessing&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#618794;&quot;&gt;raw &amp;#8594; bronze &amp;#8594; silver &amp;#8594; gold&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#618794;&quot;&gt;parse, chunk, enrich, embed&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF5F46;strokeWidth=2;align=left;spacingLeft=48;verticalAlign=middle;spacing=8;fontSize=17;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=18;" vertex="1" parent="build">
          <mxGeometry x="20" y="176" width="460" height="93" as="geometry"/>
        </mxCell>
        <mxCell id="idx" value="&lt;b style=&quot;font-size:17px;color:#1B3139;&quot;&gt;AI Search index&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#618794;&quot;&gt;written only here&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF5F46;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;fontSize=17;" vertex="1" parent="build">
          <mxGeometry x="20" y="286" width="460" height="86" as="geometry"/>
        </mxCell>
        <mxCell id="agent" value="&lt;b style=&quot;font-size:17px;color:#1B3139;&quot;&gt;Agent development&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#618794;&quot;&gt;chain &amp;#8594; tool &amp;#8594; retriever &amp;#8594; ACL&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#618794;&quot;&gt;versioned separately, deployed as one endpoint&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF5F46;strokeWidth=2;align=left;spacingLeft=48;verticalAlign=middle;spacing=8;fontSize=17;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=18;" vertex="1" parent="build">
