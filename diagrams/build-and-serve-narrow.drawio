        <mxCell id="serve" value="SERVE  ·  live request" style="swimlane;html=1;whiteSpace=wrap;startSize=46;horizontal=1;fillColor=#FF5F46;swimlaneFillColor=#FFFFFF;strokeColor=#FF5F46;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;container=1;collapsible=0;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="30" y="670" width="500" height="510" as="geometry"/>
        </mxCell>
        <mxCell id="ui" value="&lt;b style=&quot;font-size:17px;color:#1B3139;&quot;&gt;User interface&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#618794;&quot;&gt;Teams or a web UI.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D9D7CE;strokeWidth=2;align=left;spacingLeft=48;verticalAlign=middle;spacing=8;fontSize=17;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=48;" vertex="1" parent="serve">
          <mxGeometry x="20" y="66" width="460" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="uiico" value="" style="shape=image;html=1;imageAspect=1;verticalAlign=middle;labelBackgroundColor=none;image=data:image/svg+xml,;" vertex="1" parent="serve">
          <mxGeometry x="30" y="85" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="dep" value="&lt;b style=&quot;font-size:17px;color:#1B3139;&quot;&gt;Deployed agent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#618794;&quot;&gt;the ACL narrows retrieval to the caller,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#618794;&quot;&gt;so one agent serves every audience&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF5F46;strokeWidth=2;align=left;spacingLeft=48;verticalAlign=middle;spacing=8;fontSize=17;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=18;" vertex="1" parent="serve">
          <mxGeometry x="20" y="152" width="460" height="93" as="geometry"/>
        </mxCell>
        <mxCell id="read" value="&lt;b style=&quot;font-size:17px;color:#1B3139;&quot;&gt;the same index&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#618794;&quot;&gt;read at query time, never written&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF5F46;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;fontSize=17;" vertex="1" parent="serve">
          <mxGeometry x="20" y="262" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="gen" value="&lt;b style=&quot;font-size:17px;color:#1B3139;&quot;&gt;Genie space&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#618794;&quot;&gt;SQL over governed tables.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#618794;&quot;&gt;Unity Catalog evaluates the caller.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#00A972;strokeWidth=2;align=left;spacingLeft=48;verticalAlign=middle;spacing=8;fontSize=17;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=18;" vertex="1" parent="serve">
          <mxGeometry x="260" y="262" width="220" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="who" value="&lt;span style=&quot;font-size:15px;color:#1B3139;&quot;&gt;To the index: &lt;b&gt;your ACL&lt;/b&gt;, in code. To Genie: &lt;b&gt;Unity Catalog&lt;/b&gt;, per caller. Both on the caller's credentials.&lt;/span&gt;" style="shape=note;size=16;html=1;whiteSpace=wrap;fillColor=#F9F7F4;strokeColor=#D9D7CE;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=15;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="serve">
          <mxGeometry x="20" y="412" width="460" height="62" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#143D4A;strokeWidth=2;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontSize=10;fontStyle=1;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="serve" source="ui" target="dep">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="s2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#FF5F46;strokeWidth=2;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontSize=10;fontStyle=1;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="serve" source="dep" target="read">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#00A972;strokeWidth=2;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontSize=10;fontStyle=1;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="serve" source="dep" target="gen">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="foot" value="&lt;span style=&quot;font-size:15px;color:#1B3139;&quot;&gt;Enforcing the ACL at query time means no per-audience index and no copy of the corpus outside Databricks. The trade is that the access decision runs in code you wrote on the serve side.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEEDE9;strokeColor=none;align=left;spacingLeft=16;spacingTop=12;verticalAlign=top;fontSize=15;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="30" y="1210" width="500" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="cred" value="&lt;span style=&quot;font-size:13px;color:#618794;&quot;&gt;OneDNA · onedna.nl&lt;/span&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=13;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
