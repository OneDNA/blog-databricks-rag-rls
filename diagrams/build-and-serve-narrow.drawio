<mxfile host="app.diagrams.net" agent="OneDNA" version="24.7.17">
  <diagram id="rls-build-serve-narrow" name="Build and serve (narrow)">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="560" pageHeight="1400" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b style=&quot;font-size:22px;color:#1B3139;&quot;&gt;AI RAG agent and index development&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#618794;&quot;&gt;Build writes the index on a schedule.&lt;br&gt;Serve reads it on every request.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="30" y="16" width="500" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="build" value="BUILD  ·  batch, scheduled" style="swimlane;html=1;whiteSpace=wrap;startSize=46;horizontal=1;fillColor=#FF5F46;swimlaneFillColor=#FFFFFF;strokeColor=#FF5F46;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;container=1;collapsible=0;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="30" y="130" width="500" height="510" as="geometry"/>
