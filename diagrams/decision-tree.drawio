<mxfile host="app.diagrams.net" agent="OneDNA" version="24.7.17">
  <diagram id="rls-decision-tree" name="Which enforcement path">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1020" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b style=&quot;font-size:20px;color:#1B3139;&quot;&gt;Enforcement path selection&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#618794;&quot;&gt;Who enforces access control on each path, and how it is verified.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="960" height="73" as="geometry"/>
        </mxCell>
        <mxCell id="start" value="&lt;b&gt;You need per-user access control&lt;br&gt;over retrieved content&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;fillColor=#F9F7F4;strokeColor=#143D4A;strokeWidth=2;align=center;verticalAlign=middle;fontSize=13;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="290" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="&lt;b&gt;Is the content&lt;br&gt;structured?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#143D4A;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="615" y="214" width="180" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="&lt;b&gt;Interactive caller?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#618794;&quot;&gt;a human, live&lt;/span&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#143D4A;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="245" y="382" width="185" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="&lt;b&gt;Does the ACL fit the&lt;br&gt;index metadata columns?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#618794;&quot;&gt;flat, per-chunk, no joins&lt;/span&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#143D4A;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="950" y="372" width="225" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="uc" value="&lt;b style=&quot;font-size:13px;color:#1B3139;&quot;&gt;Unity Catalog RLS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#618794;&quot;&gt;row filters and column masks, or an ABAC policy at catalog scope&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1B3139;&quot;&gt;&lt;b&gt;The platform enforces.&lt;/b&gt; Resolves per caller, and holds across the agent and Teams hops.&lt;br&gt;&lt;br&gt;Test it against a case it has to deny.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#00A972;strokeWidth=3;align=left;spacingLeft=12;spacingRight=10;verticalAlign=top;spacingTop=40;fontSize=12;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="60" y="570" width="240" height="178" as="geometry"/>
        </mxCell>
        <mxCell id="ucico" value="" style="shape=image;html=1;imageAspect=1;verticalAlign=middle;labelBackgroundColor=none;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="72" y="580" width="26" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="sp" value="&lt;b style=&quot;font-size:13px;color:#1B3139;&quot;&gt;Review the SP's grants&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#618794;&quot;&gt;the service principal &lt;b&gt;is&lt;/b&gt; the identity&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1B3139;&quot;&gt;Every human calling through it sees the union of what the SP may read, with no differentiation between them. On this path that is the whole of your access control.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF3621;strokeWidth=3;align=left;spacingLeft=12;spacingRight=10;verticalAlign=top;spacingTop=40;fontSize=12;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="340" y="570" width="245" height="196" as="geometry"/>
        </mxCell>
        <mxCell id="spico" value="" style="shape=image;html=1;imageAspect=1;verticalAlign=middle;labelBackgroundColor=none;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="352" y="580" width="26" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="code" value="&lt;b style=&quot;font-size:13px;color:#1B3139;&quot;&gt;Code ACL + assert_enforceable&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#618794;&quot;&gt;you enforce, at query time&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1B3139;&quot;&gt;Resolve groups per request from the caller's own token. A naming convention works until access is a &lt;b&gt;combination&lt;/b&gt; of columns; then use a &lt;b&gt;declared table&lt;/b&gt;.&lt;br&gt;&lt;br&gt;Refuse on error. Empty is the default. Malformed raises.&lt;br&gt;&lt;br&gt;Test the denial path: the happy path passes either way.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF5F46;strokeWidth=3;align=left;spacingLeft=12;spacingRight=10;verticalAlign=top;spacingTop=40;fontSize=12;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="860" y="570" width="255" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="codeico" value="" style="shape=image;html=1;imageAspect=1;verticalAlign=middle;labelBackgroundColor=none;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="872" y="580" width="26" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="pg" value="&lt;b style=&quot;font-size:13px;color:#1B3139;&quot;&gt;Consider pgvector on Lakebase&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#618794;&quot;&gt;move enforcement back into the database&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1B3139;&quot;&gt;Your ACL becomes a row-level security policy again, evaluated by the engine rather than by your retrieval code.&lt;br&gt;&lt;br&gt;A governance argument rather than a latency one, and the stronger of the two.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#143D4A;strokeWidth=3;align=left;spacingLeft=12;spacingRight=10;verticalAlign=top;spacingTop=40;fontSize=12;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="1160" y="570" width="235" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="pgico" value="" style="shape=image;html=1;imageAspect=1;verticalAlign=middle;labelBackgroundColor=none;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="1172" y="580" width="26" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="d4" value="&lt;b&gt;Does the chain need&lt;br&gt;UC Volumes or file ops?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#143D4A;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="875" y="830" width="225" height="106" as="geometry"/>
        </mxCell>
        <mxCell id="hostA" value="&lt;b style=&quot;font-size:12px;color:#1B3139;&quot;&gt;Databricks Apps&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#618794;&quot;&gt;the only host that reaches Volumes&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF5F46;strokeWidth=2;align=left;spacingLeft=44;verticalAlign=middle;spacing=6;fontSize=12;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=42;" vertex="1" parent="1">
          <mxGeometry x="1160" y="848" width="235" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="hostAico" value="" style="shape=image;html=1;imageAspect=1;verticalAlign=middle;labelBackgroundColor=none;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="1170" y="864" width="28" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="hostB" value="&lt;b style=&quot;font-size:12px;color:#1B3139;&quot;&gt;Apps or Model Serving&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#618794;&quot;&gt;write the chain host-agnostically&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#618794;&quot;&gt;and it stays a config change&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF5F46;strokeWidth=2;align=left;spacingLeft=44;verticalAlign=middle;spacing=6;fontSize=12;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=42;" vertex="1" parent="1">
          <mxGeometry x="590" y="848" width="250" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="hostBico" value="" style="shape=image;html=1;imageAspect=1;verticalAlign=middle;labelBackgroundColor=none;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="610" y="864" width="28" height="28" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#143D4A;strokeWidth=2;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontSize=10;fontStyle=1;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="d1">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c2" value="tables, rows, numbers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#143D4A;strokeWidth=2;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontSize=10;fontStyle=1;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="d1" target="d2">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="337" y="262"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="c3" value="documents, prose" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#143D4A;strokeWidth=2;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontSize=10;fontStyle=1;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="d1" target="d3">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1062" y="262"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="c4" value="yes, a human asks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#00A972;strokeWidth=2;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontSize=10;fontStyle=1;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="d2" target="uc">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="430"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="c5" value="no, a service principal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#FF3621;strokeWidth=2;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontSize=10;fontStyle=1;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d2" target="sp">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="337" y="526"/><mxPoint x="462" y="526"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="c6" value="yes, flat and per-chunk" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#FF5F46;strokeWidth=2;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontSize=10;fontStyle=1;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="d3" target="code">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="430"/><mxPoint x="910" y="530"/><mxPoint x="987" y="530"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="c7" value="no, needs joins or&amp;#10;external rules" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#143D4A;strokeWidth=2;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontSize=10;fontStyle=1;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="d3" target="pg">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1277" y="430"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#143D4A;strokeWidth=2;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontSize=10;fontStyle=1;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="code" target="d4">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c9" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#143D4A;strokeWidth=2;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontSize=10;fontStyle=1;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d4" target="hostA">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="c10" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#143D4A;strokeWidth=2;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontSize=10;fontStyle=1;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d4" target="hostB">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="note" value="&lt;b style=&quot;font-size:13px;color:#1B3139;&quot;&gt;Whichever branch you land on&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#1B3139;&quot;&gt;&lt;b&gt;1.&lt;/b&gt; Point the filter at something that must return nothing, and watch it return nothing. A control you have only seen succeed is a control you have not tested.&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; Make your two zeros distinguishable: &quot;no entitlement&quot; and &quot;something broke&quot; look identical from outside.&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; Assert on the identity that produced the answer. An answer arriving tells you nothing about who it was filtered for.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEEDE9;strokeColor=none;align=left;spacingLeft=14;spacingTop=10;verticalAlign=top;fontSize=11;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="60" y="810" width="490" height="146" as="geometry"/>
        </mxCell>
        <mxCell id="cred" value="&lt;span style=&quot;color:#618794;&quot;&gt;OneDNA · onedna.nl&lt;/span&gt;" style="text;html=1;align=right;verticalAlign=middle;fontSize=11;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="1000" y="958" width="395" height="36" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
