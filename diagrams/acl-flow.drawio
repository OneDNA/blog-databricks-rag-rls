        <mxCell id="t" value="&lt;b style=&quot;font-size:20px;color:#1B3139;&quot;&gt;How the ACL resolves, per request&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#618794;&quot;&gt;Every branch that cannot answer &quot;who is asking&quot; ends closed.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
