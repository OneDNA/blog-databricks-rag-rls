          <mxGeometry x="290" y="490" width="260" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="err" value="&lt;b style=&quot;font-size:12px;color:#FF3621;&quot;&gt;PermissionError&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1B3139;&quot;&gt;an axis that is not a column of the index would not be applied, so the request stops rather than serving unfiltered results.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF3621;strokeWidth=3;align=left;spacingLeft=12;spacingRight=10;verticalAlign=top;spacingTop=12;fontSize=11;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
