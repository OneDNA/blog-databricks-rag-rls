<mxfile host="app.diagrams.net" agent="OneDNA" version="24.7.17">
  <diagram id="rls-decision-narrow" name="Enforcement path selection (narrow)">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="1160" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b style=&quot;font-size:22px;color:#1B3139;&quot;&gt;Enforcement path selection&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="30" y="16" width="760" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="start" value="&lt;b style=&quot;font-size:17px;&quot;&gt;You need per-user access control&lt;br&gt;over retrieved content&lt;/b&gt;" style="ellipse;html=1;whiteSpace=wrap;fillColor=#F9F7F4;strokeColor=#143D4A;strokeWidth=2;align=center;verticalAlign=middle;fontSize=17;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="680" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="&lt;b style=&quot;font-size:17px;&quot;&gt;Is the content structured?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#143D4A;strokeWidth=2;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="110" y="254" width="600" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="uc" value="&lt;b style=&quot;font-size:17px;color:#1B3139;&quot;&gt;yes &amp;#8594; Unity Catalog RLS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#1B3139;&quot;&gt;Row filters and column masks, or an ABAC policy at catalog scope. &lt;b&gt;The platform enforces&lt;/b&gt;, per caller, and it holds across the agent and front-end hops.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#00A972;strokeWidth=3;align=left;spacingLeft=48;verticalAlign=middle;spacing=8;fontSize=17;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=48;" vertex="1" parent="1">
          <mxGeometry x="30" y="380" width="760" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="ucico" value="" style="shape=image;html=1;imageAspect=1;verticalAlign=middle;labelBackgroundColor=none;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="42" y="418" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="note1" value="&lt;span style=&quot;font-size:15px;color:#1B3139;&quot;&gt;On a non-interactive path the SP's access is the access used. Review its grants.&lt;/span&gt;" style="shape=note;size=16;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF3621;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=17;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="30" y="508" width="760" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="&lt;b style=&quot;font-size:17px;&quot;&gt;no &amp;#8594; does the ACL fit the index metadata columns?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#143D4A;strokeWidth=2;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="70" y="606" width="680" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="code" value="&lt;b style=&quot;font-size:17px;color:#1B3139;&quot;&gt;yes &amp;#8594; code ACL + assert_enforceable&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#1B3139;&quot;&gt;You enforce, at query time. Resolve groups per request from the caller's own token; map via a declared table. Test the denial path.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF5F46;strokeWidth=3;align=left;spacingLeft=48;verticalAlign=middle;spacing=8;fontSize=17;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=48;" vertex="1" parent="1">
          <mxGeometry x="30" y="756" width="760" height="108" as="geometry"/>
        </mxCell>
        <mxCell id="codeico" value="" style="shape=image;html=1;imageAspect=1;verticalAlign=middle;labelBackgroundColor=none;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="42" y="794" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="pg" value="&lt;b style=&quot;font-size:17px;color:#1B3139;&quot;&gt;no &amp;#8594; consider pgvector on Lakebase&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#1B3139;&quot;&gt;Your ACL becomes a row-level security policy the engine evaluates, rather than your retrieval code.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#143D4A;strokeWidth=3;align=left;spacingLeft=48;verticalAlign=middle;spacing=8;fontSize=17;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=48;" vertex="1" parent="1">
          <mxGeometry x="30" y="884" width="760" height="96" as="geometry"/>
        </mxCell>
        <mxCell id="pgico" value="" style="shape=image;html=1;imageAspect=1;verticalAlign=middle;labelBackgroundColor=none;image=data:image/svg+xml,;" vertex="1" parent="1">
          <mxGeometry x="42" y="916" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="&lt;b style=&quot;font-size:17px;&quot;&gt;Does the chain need UC Volumes or file operations?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#143D4A;strokeWidth=2;align=center;verticalAlign=middle;fontSize=17;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="70" y="1000" width="680" height="116" as="geometry"/>
        </mxCell>
        <mxCell id="host" value="&lt;span style=&quot;font-size:15px;color:#1B3139;&quot;&gt;&lt;b&gt;yes&lt;/b&gt; &amp;#8594; Databricks Apps is the only host that reaches Volumes.&lt;br&gt;&lt;b&gt;no&lt;/b&gt; &amp;#8594; either host. Write the chain so it does not know which, and that stays a configuration change.&lt;/span&gt;" style="shape=note;size=16;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF5F46;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=17;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="30" y="1140" width="760" height="80" as="geometry"/>
        </mxCell>
