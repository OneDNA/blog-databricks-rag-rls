        </mxCell>
        <mxCell id="genie" value="&lt;b style=&quot;font-size:17px;color:#1B3139;&quot;&gt;Genie space&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#618794;&quot;&gt;SQL, Unity Catalog per caller&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#00A972;strokeWidth=2;align=left;spacingLeft=48;verticalAlign=middle;spacing=8;fontSize=17;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=18;" vertex="1" parent="sv">
          <mxGeometry x="410" y="176" width="350" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="ans" value="&lt;b style=&quot;font-size:17px;color:#1B3139;&quot;&gt;Answer + which control applied&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#1B3139;&quot;&gt;so a citation traces back to the permission that admitted it&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#143D4A;strokeWidth=3;align=left;spacingLeft=48;verticalAlign=middle;spacing=8;fontSize=17;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=18;" vertex="1" parent="sv">
