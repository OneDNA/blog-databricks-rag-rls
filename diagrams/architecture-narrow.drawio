          <mxGeometry x="32" y="103" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="exch" value="&lt;b style=&quot;font-size:17px;color:#1B3139;&quot;&gt;RFC 8693 token exchange&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#618794;&quot;&gt;the front end returns an Entra token;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#618794;&quot;&gt;Databricks rejects it, so the bot swaps it&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D9D7CE;strokeWidth=2;align=left;spacingLeft=48;verticalAlign=middle;spacing=8;fontSize=17;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=48;" vertex="1" parent="id">
