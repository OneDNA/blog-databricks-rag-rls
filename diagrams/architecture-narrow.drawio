        <mxCell id="host" value="&lt;span style=&quot;font-size:15px;color:#1B3139;&quot;&gt;&lt;b&gt;Apps&lt;/b&gt; reads the token from a header and reaches Volumes.&lt;br&gt;&lt;b&gt;Model Serving&lt;/b&gt; holds it in the runtime, but not Volumes.&lt;/span&gt;" style="shape=note;size=16;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF5F46;strokeWidth=1;align=left;verticalAlign=top;spacing=10;fontSize=15;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="id">
