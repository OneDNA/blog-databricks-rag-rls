  <diagram id="rls-architecture-narrow" name="RLS architecture (narrow)">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="1430" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
