        <mxCell id="pipe" value="&lt;b style=&quot;font-size:17px;color:#1B3139;&quot;&gt;Gather &amp;#8594; parse &amp;#8594; chunk &amp;#8594; enrich &amp;#8594; embed&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#618794;&quot;&gt;one governed Unity Catalog artefact per stage&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF5F46;strokeWidth=2;align=left;spacingLeft=48;verticalAlign=middle;spacing=8;fontSize=17;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=18;" vertex="1" parent="bl">
          <mxGeometry x="20" y="62" width="350" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="brk" value="&lt;b style=&quot;font-size:17px;color:#FF3621;&quot;&gt;enforcement stops here&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#1B3139;&quot;&gt;a vector is a list of floats; the security context does not reach the index&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF3621;strokeWidth=3;dashed=1;dashPattern=6 4;fixDash=1;align=left;spacingLeft=48;verticalAlign=middle;spacing=8;fontSize=17;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=18;" vertex="1" parent="bl">
