        <mxCell id="exchico" value="" style="shape=image;html=1;imageAspect=1;verticalAlign=middle;labelBackgroundColor=none;image=data:image/svg+xml,;" vertex="1" parent="id">
          <mxGeometry x="422" y="103" width="30" height="30" as="geometry"/>
