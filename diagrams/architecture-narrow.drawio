        <mxCell id="lg" value="&lt;span style=&quot;font-size:15px;color:#1B3139;&quot;&gt;&lt;b&gt;&lt;span style=&quot;color:#00A972;&quot;&gt;&amp;#9632;&lt;/span&gt; Unity Catalog enforces&lt;/b&gt; &amp;nbsp; &lt;b&gt;&lt;span style=&quot;color:#FF5F46;&quot;&gt;&amp;#9632;&lt;/span&gt; your code enforces&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;span style=&quot;color:#FF3621;&quot;&gt;&amp;#9632;&lt;/span&gt; nothing enforces&lt;/b&gt;&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D9D7CE;strokeWidth=1;align=left;spacingLeft=12;verticalAlign=middle;fontSize=15;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
