        </mxCell>
        <mxCell id="idx2" value="&lt;b style=&quot;font-size:17px;color:#1B3139;&quot;&gt;AI Search index&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#618794;&quot;&gt;similarity + your filter&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF5F46;strokeWidth=2;align=left;spacingLeft=48;verticalAlign=middle;spacing=8;fontSize=17;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=18;" vertex="1" parent="sv">
