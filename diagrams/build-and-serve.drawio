        <mxCell id="b3" value="built against" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#143D4A;strokeWidth=2;dashed=1;dashPattern=6 4;fixDash=1;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontSize=17;fontStyle=1;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;exitX=0.25;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="build" source="agentdev" target="idx">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="serve" value="SERVE  ·  live request" style="swimlane;html=1;whiteSpace=wrap;startSize=56;horizontal=1;fillColor=#FF5F46;swimlaneFillColor=#FFFFFF;strokeColor=#FF5F46;strokeWidth=2;fontColor=#FFFFFF;fontSize=22;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;container=1;collapsible=0;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="960" y="180" width="880" height="860" as="geometry"/>
        </mxCell>
        <mxCell id="ui" value="&lt;b style=&quot;font-size:20px;color:#1B3139;&quot;&gt;User interface&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;a web UI, Teams, …&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;Asks questions, gets answers.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D9D7CE;strokeWidth=2;align=left;spacingLeft=48;verticalAlign=middle;spacing=6;fontSize=20;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=48;" vertex="1" parent="serve">
          <mxGeometry x="24" y="80" width="400" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="uiico" value="" style="shape=image;html=1;imageAspect=1;verticalAlign=middle;labelBackgroundColor=none;image=data:image/svg+xml,;" vertex="1" parent="serve">
          <mxGeometry x="34" y="132" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="agent" value="&lt;b style=&quot;font-size:20px;color:#1B3139;&quot;&gt;Deployed agent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;chain &amp;#8594; tool &amp;#8594; &lt;b&gt;ACL&lt;/b&gt; &amp;#8594; data&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;the ACL narrows retrieval to the caller,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;so &lt;b&gt;one agent serves every audience&lt;/b&gt;&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF5F46;strokeWidth=3;align=left;spacingLeft=48;verticalAlign=middle;spacing=6;fontSize=20;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=48;" vertex="1" parent="serve">
          <mxGeometry x="24" y="290" width="360" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="agentico2" value="" style="shape=image;html=1;imageAspect=1;verticalAlign=middle;labelBackgroundColor=none;image=data:image/svg+xml,;" vertex="1" parent="serve">
          <mxGeometry x="34" y="362" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="read" value="&lt;b style=&quot;font-size:20px;&quot;&gt;the same AI Search index&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;read at query time, never written&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF3621;strokeWidth=2;align=center;verticalAlign=middle;fontSize=18;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="serve">
          <mxGeometry x="444" y="80" width="410" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="gen" value="&lt;b style=&quot;font-size:20px;color:#1B3139;&quot;&gt;Genie space&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;SQL over governed tables.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;Unity Catalog evaluates the caller.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#00A972;strokeWidth=2;align=left;spacingLeft=48;verticalAlign=middle;spacing=6;fontSize=20;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=48;" vertex="1" parent="serve">
          <mxGeometry x="490" y="300" width="364" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="genico2" value="" style="shape=image;html=1;imageAspect=1;verticalAlign=middle;labelBackgroundColor=none;image=data:image/svg+xml,;" vertex="1" parent="serve">
          <mxGeometry x="500" y="362" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="who" value="&lt;b&gt;Who enforces on each branch&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;&quot;&gt;To the index: your ACL, in code, at query time.&lt;br&gt;To Genie: Unity Catalog, per caller.&lt;br&gt;&lt;br&gt;Both run on the caller&amp;apos;s credentials.&lt;/span&gt;" style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#F9F7F4;strokeColor=#D9D7CE;strokeWidth=1;align=left;verticalAlign=top;spacing=8;fontSize=19;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="serve">
          <mxGeometry x="24" y="520" width="830" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#143D4A;strokeWidth=2;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontSize=17;fontStyle=1;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="serve" source="ui" target="agent">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="s2" value="filtered query" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#FF5F46;strokeWidth=2;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontSize=17;fontStyle=1;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="serve" source="agent" target="read">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="s3" value="data question" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#00A972;strokeWidth=2;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontSize=17;fontStyle=1;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="serve" source="agent" target="gen">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="437" y="378"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="foot" value="&lt;span style=&quot;font-size:20px;color:#1B3139;&quot;&gt;Enforcing the ACL at query time means no per-audience index and no copy of the corpus outside Databricks. The trade is that the access decision runs in code you wrote on the serve side, against columns you chose on the build side.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EEEDE9;strokeColor=none;align=left;spacingLeft=20;spacingTop=16;verticalAlign=top;fontSize=20;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="40" y="1070" width="1800" height="76" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
