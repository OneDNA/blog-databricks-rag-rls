      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b style=&quot;font-size:34px;color:#1B3139;&quot;&gt;AI RAG agent and index development&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1500" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="build" value="BUILD  ·  batch, scheduled" style="swimlane;html=1;whiteSpace=wrap;startSize=56;horizontal=1;fillColor=#FF5F46;swimlaneFillColor=#FFFFFF;strokeColor=#FF5F46;strokeWidth=2;fontColor=#FFFFFF;fontSize=22;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;container=1;collapsible=0;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="880" height="860" as="geometry"/>
        </mxCell>
        <mxCell id="src" value="&lt;b style=&quot;font-size:20px;color:#1B3139;&quot;&gt;Source systems&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;SharePoint, fileshares.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;Owners publish there;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;nothing is copied by hand.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D9D7CE;strokeWidth=2;align=left;spacingLeft=60;verticalAlign=middle;spacing=6;fontSize=20;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=16;" vertex="1" parent="build">
          <mxGeometry x="24" y="80" width="360" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="prep" value="&lt;b style=&quot;font-size:20px;color:#1B3139;&quot;&gt;Preprocessing&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;raw &amp;#8594; bronze &amp;#8594; silver &amp;#8594; gold&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;parse, chunk, enrich, embed&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF5F46;strokeWidth=2;align=left;spacingLeft=48;verticalAlign=middle;spacing=6;fontSize=20;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=48;" vertex="1" parent="build">
          <mxGeometry x="490" y="80" width="364" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="prepico" value="" style="shape=image;html=1;imageAspect=1;verticalAlign=middle;labelBackgroundColor=none;image=data:image/svg+xml,;" vertex="1" parent="build">
          <mxGeometry x="500" y="145" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="idx" value="&lt;b style=&quot;font-size:20px;&quot;&gt;AI Search index&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;written only here&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF3621;strokeWidth=2;align=center;verticalAlign=middle;fontSize=18;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="build">
          <mxGeometry x="24" y="300" width="400" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="agentdev" value="&lt;b style=&quot;font-size:20px;color:#1B3139;&quot;&gt;Agent development&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;chain &amp;#8594; tool &amp;#8594; retriever &amp;#8594; &lt;b&gt;ACL&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;built and versioned separately,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;then deployed as one endpoint&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF5F46;strokeWidth=2;align=left;spacingLeft=48;verticalAlign=middle;spacing=6;fontSize=20;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=48;" vertex="1" parent="build">
          <mxGeometry x="24" y="520" width="500" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="agentdevico" value="" style="shape=image;html=1;imageAspect=1;verticalAlign=middle;labelBackgroundColor=none;image=data:image/svg+xml,;" vertex="1" parent="build">
          <mxGeometry x="34" y="587" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="uc" value="&lt;b style=&quot;font-size:20px;color:#1B3139;&quot;&gt;Unity Catalog&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;one governance layer over both: lineage for every&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;artefact the pipeline writes, and the grants the&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;color:#618794;&quot;&gt;agent&amp;apos;s ACL resolves against at query time&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#00A972;strokeWidth=3;align=left;spacingLeft=48;verticalAlign=middle;spacing=6;fontSize=20;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;spacingLeft=48;" vertex="1" parent="build">
          <mxGeometry x="24" y="720" width="830" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ucico2" value="" style="shape=image;html=1;imageAspect=1;verticalAlign=middle;labelBackgroundColor=none;image=data:image/svg+xml,;" vertex="1" parent="build">
          <mxGeometry x="34" y="765" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="acln" value="&lt;b style=&quot;color:#FF3621;&quot;&gt;The index has no row filter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:17px;&quot;&gt;Whatever the ACL needs at query time has to be written into a metadata column here, at build. Changing that later means a rebuild.&lt;/span&gt;" style="shape=note;size=14;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FF3621;strokeWidth=1;align=left;verticalAlign=top;spacing=8;fontSize=19;fontStyle=0;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;" vertex="1" parent="build">
          <mxGeometry x="444" y="300" width="410" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="b1" value="on change" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#143D4A;strokeWidth=2;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontSize=17;fontStyle=1;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="build" source="src" target="prep">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="b2" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#FF3621;strokeWidth=3;labelBackgroundColor=#FFFFFF;labelBorderColor=none;fontSize=17;fontStyle=1;fontColor=#1B3139;fontFamily=DM Sans, DM Sans 14pt, Segoe UI, Helvetica Neue, Helvetica, Arial, sans-serif;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DDM%2BSans%3A400%2C500%2C700;exitX=0;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="build" source="prep" target="idx">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="204" y="268"/></Array></mxGeometry>
