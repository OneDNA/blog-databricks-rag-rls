# Editorial process — internal, not part of the article
.style/

# Diagram authoring — the .drawio files and build.py that generates them are
# committed, so the rendered images under diagrams/rendered/ can be reproduced
# from this repo alone. Only the local HTML preview is untracked.
diagrams/chat-response.html

# PDF output and its build intermediates. Regenerate with the markdown-to-pdf skill —
# a stale PDF beside an edited article is worse than no PDF.
.pdfbuild/
*.pdf

# Export bundles. Same reasoning: regenerated from the markdown, never edited here.
dist/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Local preview exports — these embed absolute paths from the machine that made them
README.html
README.nl.html

# OS
Thumbs.db
.DS_Store
